{
  "name": "investime",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace @investime/web run dev",
    "dev:api": "npm --workspace @investime/api run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --workspace @investime/web run build",
    "build:api": "npm --workspace @investime/api run build",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm --workspace @investime/web run lint",
    "lint:api": "npm --workspace @investime/api run lint"
  }
}